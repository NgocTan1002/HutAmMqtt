# MQTT broker. Leave the default for a local broker, then replace it with the
# address configured in MQTTX when connecting to the real device.
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USE_TLS=false
MQTT_USERNAME=
MQTT_PASSWORD=
DEVICE_ID=mayhutam1

# Current device topics
MQTT_TELEMETRY_TOPIC=mayhutam1/nhan
MQTT_COMMAND_TOPIC=mayhutam1/caidat
# Current protocol does not define a separate response topic. Use the existing
# receive topic until firmware confirms another topic.
MQTT_RESPONSE_TOPIC=mayhutam1/nhan

# Device state rule: telemetry is expected every 5 seconds.
DEVICE_OFFLINE_AFTER_SECONDS=20

# Local application ports planned for day 1
BACKEND_PORT=3001
FRONTEND_PORT=5173
# Reload enabled broker/device configuration from PostgreSQL every 5 seconds.
CONFIG_REFRESH_INTERVAL_MS=5000
# Generate this local secret with: npm run credentials:setup --workspace=backend
CONFIG_ENCRYPTION_KEY=

# PostgreSQL is the active database from phase 3 onward.
DATABASE_DRIVER=postgres
DATABASE_PATH=data/nhiet-am-mqtt.db
DATABASE_URL=postgresql://nhiet_am_app:change_me@localhost:5432/nhiet_am_mqtt
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_SSL=false
