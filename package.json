{
  "name": "nhiet-am-mqtt",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "build": "npm run build --workspace=backend && npm run build --workspace=frontend",
    "check": "npm run check --workspace=backend && npm run check --workspace=frontend",
    "db:migrate": "npm run db:migrate --workspace=backend",
    "db:migrate:down": "npm run db:migrate:down --workspace=backend",
    "db:seed:current": "npm run db:seed:current --workspace=backend",
    "db:smoke": "npm run db:smoke --workspace=backend",
    "db:verify": "npm run db:verify --workspace=backend",
    "db:verify:test": "npm run db:verify:test --workspace=backend",
    "test:postgres": "npm run test:postgres --workspace=backend",
    "test:unit": "npm run test:unit --workspace=backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
